# Durant Media Server Bot
# Any bot key may use KEY_FILE=/run/secrets/name instead. Do not set both forms, even with KEY=.
# File values are read once at startup and have one trailing newline removed.

# Required
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_CHANNEL_ID=
ADMIN_USER_ID=
OVERSEERR_URL=http://seerr:5055
OVERSEERR_API_KEY=
# Read-only sweep that repairs local request statuses if a Seerr webhook was missed (0 disables).
REQUEST_RECONCILE_MINUTES=15
REQUEST_STALLED_HOURS=72
TUNNEL_DOMAIN=files.example.com
RAID_PATH=/mnt/raid
# docker-compose host mount source for RAID_PATH inside container
MEDIA_HOST_PATH=/mnt/raid

# Plex auth (set PLEX_TOKEN OR set username+password)
PLEX_TOKEN=
PLEX_USERNAME=
PLEX_PASSWORD=
PLEX_EXCLUDE_SERVERS=

# Webhook auth. Both values are REQUIRED — TUNNEL_DOMAIN is itself required above, which means
# these webhook endpoints are always reachable from the internet, live deletion or not.
WEBHOOK_SECRET=
TAUTULLI_WEBHOOK_SECRET=

# Optional notification channels — any left blank falls back to ADMIN_CHANNEL_ID.
# Suggested simple setup with three channels:
#   #media-requests  -> REQUESTS_CHANNEL_ID + CLEANUP_CHANNEL_ID
#   #media-alerts    -> SYSTEM_ALERTS_CHANNEL_ID + DOWNLOADS_CHANNEL_ID (or leave blank = admin)
#   #media-admin-log -> AUDIT_CHANNEL_ID + DEPLOY_CHANNEL_ID
# New Seerr requests + approve/deny embeds, failed requests
REQUESTS_CHANNEL_ID=
# Low disk space and other health alerts
SYSTEM_ALERTS_CHANNEL_ID=
# Stuck downloads, large download started
DOWNLOADS_CHANNEL_ID=
# Heavy video-transcode alerts from Tautulli (falls back to ADMIN_CHANNEL_ID when unset)
PLAYBACK_CHANNEL_ID=
# Finished-watching keep/delete prompts, janitor + retention reports
CLEANUP_CHANNEL_ID=
# User linked/unlinked, member left, Plex revoked
AUDIT_CHANNEL_ID=
# "Bot online" ping after each restart/update. NO fallback: only sends when set,
# so Watchtower restarts don't ping your admin channel. Every restart logs the outcome
# ("Deploy ping posted to channel …" / "skipped: DEPLOY_CHANNEL_ID is unset" / the Discord
# error) — check the container log if the ping never shows up in Discord.
DEPLOY_CHANNEL_ID=

# Optional app integrations
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_4K_URL=
RADARR_4K_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Tautulli (enables /watching + heavy-transcode alerts to PLAYBACK_CHANNEL_ID)
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=
# How often to check for heavy (video) transcodes; 0 disables the alerts.
PLAYBACK_CHECK_MINUTES=5
# Minimum minutes between repeat alerts for the same user+media session.
TRANSCODE_ALERT_COOLDOWN_MINUTES=60

# Premiumize (enables /debrid account + transfer status, and the stuck-transfer watchdog)
PREMIUMIZE_API_KEY=
# Check for stuck transfers this often; 0 disables the watchdog.
PREMIUMIZE_CHECK_MINUTES=15
# A transfer counts as stuck when errored, or when its progress hasn't moved for this long
# (catches the classic "sitting at 0% forever" case).
PREMIUMIZE_STUCK_AFTER_MINUTES=45
# Minimum hours between repeat alerts for the same transfer.
PREMIUMIZE_ALERT_COOLDOWN_HOURS=6
# A stuck transfer still at (effectively) 0% with no cached source is deleted automatically
# instead of sitting in the queue re-alerting on every cooldown expiry. Everything else stuck
# still gets Retry/Clear/Ignore buttons, batched into one alert instead of one per transfer.
PREMIUMIZE_AUTO_CLEAR_DEAD=true
# Progress ceiling (percent) below which a stuck transfer counts as "dead" for auto-clear.
PREMIUMIZE_AUTO_CLEAR_MAX_PROGRESS=1

# AvistaZ private-tracker fallback (see README "AvistaZ private-tracker fallback").
# Public indexers stay the default; the bot only tags a title for AvistaZ when a request
# is escalated (admin pre-authorization at approval time, or the escalation watchdog).
# Escalating without a human is narrower than pre-authorization: AvistaZ is an Asian-content
# tracker, so only obviously-Asian TV auto-escalates (Asian original language, production
# country, or original title script). Movies never do, and neither does anything the origin
# check can't place — those get an "Escalate to AvistaZ" button instead. No knob: the button
# is always available, so the automation staying conservative costs a click, never a title.
ESCALATION_ENABLED=false
# Radarr/Sonarr indexer tag that gates AvistaZ. Must match the tag on the AvistaZ indexer.
AVISTAZ_TAG=avistaz
# Minutes an approved request may sit with nothing found/downloading before escalation.
# (The legacy ESCALATION_DELAY_HOURS key still works when this is unset.)
ESCALATION_DELAY_MINUTES=45
# Watchdog sweep interval; 0 disables the sweep (approval-time pre-auth buttons still show).
ESCALATION_CHECK_MINUTES=15
# Stop watching a request after this many days without resolution.
ESCALATION_MAX_AGE_DAYS=14
# Minutes after approval before a title that verifiably isn't in Radarr/Sonarr triggers the
# "request never landed" alert (Seerr can accept a request and silently lose it moments later —
# 'Media data not found' in its log). The alert's button adds the title straight to the arr.
ESCALATION_ARR_GRACE_MINUTES=10
# Where direct adds land. Unset = the arr's first root folder / first quality profile.
RADARR_ROOT_FOLDER=
SONARR_ROOT_FOLDER=
# Quality profile NAME (not id) for direct adds, e.g. HD-1080p.
RADARR_QUALITY_PROFILE=
SONARR_QUALITY_PROFILE=

# AvistaZ direct grab (see README "AvistaZ direct grab"). When these are set, escalation
# stops going through Radarr/Sonarr tags: the bot searches AvistaZ via Prowlarr itself,
# scores the results, sends the chosen torrent to the seedbox rTorrent, copies it home
# with rclone when it finishes, and hands the folder to Radarr/Sonarr for a normal import.
# Requires PROWLARR_URL + PROWLARR_API_KEY.
# Full rTorrent XML-RPC endpoint incl. credentials (RapidSeedbox exposes it at
# /plugins/rpc/rpc.php), e.g. https://user:pass@server.rapidseedbox.com/plugins/rpc/rpc.php
RTORRENT_URL=
# rTorrent label (d.custom1 / ruTorrent label) applied per media type.
RTORRENT_LABEL_MOVIE=radarr
RTORRENT_LABEL_TV=sonarr
# Case-insensitive substring matched against Prowlarr indexer names to find AvistaZ.
AVISTAZ_INDEXER_NAME=avistaz
# Max grabs per UTC day so automation can't drain a limited AvistaZ account. 0 = unlimited.
# Set high enough that a whole-series grab of a long-running show fits in one day; lower it if
# your AvistaZ account has a tighter download-slot budget.
AVISTAZ_DAILY_GRAB_LIMIT=100
# approve = every grab needs a Download button click; auto = escalations grab the top
# candidate themselves when its confidence >= GRAB_AUTO_CONFIDENCE (manual /avistaz
# searches always show buttons). This applies once an escalation has already been allowed —
# it can't make a movie or a non-Asian show escalate on its own; those reach the pipeline only
# after someone clicks "Escalate to AvistaZ".
GRAB_MODE=approve
GRAB_AUTO_CONFIDENCE=92
# Block a grab/adoption when an active job already covers the same episode(s) — even a
# different release/encoding/size of them (info-hash + exact-title dedupe can't catch that).
# On by default; set false to allow multiple releases of the same content into the pipeline.
GRAB_CONTENT_DEDUPE=true
# ---- Season-pack-first searching for old shows (AvistaZ-tagged series by default) ----
# Sonarr hunts missing episodes one at a time. For a show that finished airing years ago the
# whole season exists as a single torrent, so the bot searches for a season pack per incomplete
# season instead — one grab instead of N. Shows still airing are untouched: no pack exists for a
# season that's still going out weekly.
SEASON_PACK_FIRST=true
# Only series carrying AVISTAZ_TAG are season-searched. Sonarr's own SeasonSearch/EpisodeSearch
# use every configured indexer (public trackers included) and route to whatever download client
# those indexers point at — untagged, that's how a season search ends up grabbing dozens of dead
# public releases. Enable this to also season-search untagged series through Sonarr, as before.
SEASON_PACK_SONARR_UNTAGGED=false
# A tagged series searches AvistaZ directly (the same Prowlarr search → rank → seedbox rTorrent
# pipeline as /avistaz search) instead of asking Sonarr for a SeasonSearch. Requires the AvistaZ
# direct-grab pipeline to be configured (PROWLARR_URL, RTORRENT_URL, GRAB_RCLONE_REMOTE,
# GRAB_STAGING_PATH); falls back to being skipped for a tagged series if it isn't.
SEASON_PACK_AVISTAZ_DIRECT=true
# After a no-grab or partial result, query Interactive Search and report the best candidates and
# Sonarr rejection reasons in Discord. Eligible packs get admin-only buttons controlled by the
# safety limits below.
SEASON_PACK_INTERACTIVE=true
# Default off: automatically force only the top eligible pack after rechecking active grab jobs
# and Sonarr's live queue. This deliberately overrides Sonarr's rejection, so observe the manual
# buttons first and enable it only when the thresholds below have proved trustworthy.
SEASON_PACK_FORCE_GRAB=false
# Only full-season candidates meeting all three limits can be offered or automatically forced.
SEASON_PACK_MIN_SEEDERS=1
SEASON_PACK_MAX_SIZE_GB=200
SEASON_PACK_MIN_CONFIDENCE=70
SEASON_PACK_CHECK_MINUTES=180
# Give shows somebody actually requested the same treatment even while they're still airing —
# most releases are "S01" season packs whatever the show's age, and a requester is waiting on it.
# Safe on an in-progress season: only AIRED episodes count toward the missing threshold, so a
# season that's up to date is never searched.
SEASON_PACK_REQUESTED=true
# A 'continuing' series with nothing aired in this long (and nothing scheduled) counts as old.
# Series Sonarr marks 'ended' always count, whatever this is set to.
SEASON_PACK_DORMANT_DAYS=365
# Missing episodes needed before a season is searched as a pack. An entirely missing season
# always qualifies; this is the bar for partially-present seasons, where pulling a whole pack
# to fill one gap costs more bandwidth than it saves.
SEASON_PACK_MIN_MISSING=3
# Don't re-search the same season more often than this (a season with nothing available would
# otherwise be re-searched every sweep forever).
SEASON_PACK_COOLDOWN_HOURS=24
# Ceiling on season searches per sweep, so a first run over a large library doesn't fire
# hundreds of indexer searches at once.
SEASON_PACK_MAX_PER_RUN=5
# When no safe pack exists, an approved single-episode result can authorize a bounded fallback.
# Sonarr still chooses each release normally; the bot never force-grabs individual episodes.
SEASON_PACK_EPISODE_FALLBACK=true
# One EpisodeSearch command fans out to one indexer search per ID inside Sonarr. These two caps
# bound that hidden work per season and across the entire guarded season-pack run.
SEASON_PACK_EPISODE_BATCH_SIZE=25
SEASON_PACK_EPISODE_MAX_PER_RUN=50
# Deferred batches use their own retry clock instead of waiting behind the 24h pack cooldown.
SEASON_PACK_EPISODE_RETRY_MINUTES=180
# An untagged season searched through Sonarr's own indexers whose missing-episode count never
# shrinks across this many consecutive sweeps gets AVISTAZ_TAG applied automatically, so the next
# sweep routes it to AvistaZ direct grab instead of retrying the same dead public releases
# forever (defunct trackers, no real seeders). Set to 0 to disable. Never fires for a Western
# show — AvistaZ only carries Asian content, and this reads Sonarr's own originalLanguage to
# gate on it, so a stalled non-Asian show is left alone rather than wasting a search that can't
# possibly find anything.
SEASON_PACK_AUTO_TAG_AFTER_STALLS=3
# A season whose missing count hasn't shrunk in N stalled sweeps doubles its cooldown per stall
# (24h -> 48h -> 96h -> ...) instead of retrying at the same fixed cadence forever, capped at
# 2^this multiplier. Applies to every season regardless of route or content origin — unlike the
# AvistaZ auto-tag above, this isn't limited to Asian content, since a Western show stuck on dead
# public releases wastes just as much search/download budget every sweep. A real drop in the
# missing count resets a season straight back to the base cooldown. Set to 0 to disable.
SEASON_PACK_STALL_BACKOFF_MAX_STEPS=4
# ---- Whole-series grabs (TV only) ----
# One AvistaZ search usually holds more than one useful release for a show (a pack per season,
# or packs plus stray episodes), but a Download button grabs exactly one and consumes the offer.
# With this on, TV offers gain a "Grab Everything" button that sends every non-overlapping
# release in one click, and GRAB_MODE=auto grabs that whole set instead of only the top match.
GRAB_TV_COMPLETE=true
# Ceiling on releases per whole-series grab. AVISTAZ_DAILY_GRAB_LIMIT still applies and is the
# tighter limit whenever it's set — anything that doesn't fit is reported, not silently dropped.
GRAB_TV_MAX_RELEASES=6
# Confidence floor for joining a whole-series plan. Below GRAB_AUTO_CONFIDENCE on purpose: the
# top match must clear that bar by itself, later seasons only need to be plausible.
GRAB_TV_COMPLETE_MIN_CONFIDENCE=70
# rclone remote pointing at the seedbox's rTorrent download folder, e.g. rapidseedbox:files
# (remote from rclone.conf — mount the config and pass it via GRAB_RCLONE_FLAGS).
GRAB_RCLONE_REMOTE=
# Extra rclone flags for seedbox copies, e.g. for SFTP remotes:
# --config /app/data/rclone.conf --transfers 2 --checkers 4 --multi-thread-streams 0 --sftp-chunk-size 255Ki --sftp-concurrency 64
GRAB_RCLONE_FLAGS=
# Writable local staging folder inside the container (the media mount is read-only, so this
# needs its own writable mount — see docker-compose.yml) that Radarr/Sonarr can also reach.
GRAB_STAGING_PATH=
# The same staging folder as Radarr/Sonarr see it (defaults to GRAB_STAGING_PATH when they
# share the container path, e.g. /share/seedbox-staging vs /seedbox-staging).
GRAB_IMPORT_PATH=
# How often to poll the seedbox for active grabs; 0 disables the sweep.
GRAB_CHECK_MINUTES=5
GRAB_COPY_TIMEOUT_MINUTES=240
# A pushed torrent that never appears in rTorrent within this window counts as failed.
GRAB_MISSING_AFTER_MINUTES=10
# Give up watching a seedbox download after this long without completion.
GRAB_DOWNLOAD_TIMEOUT_HOURS=72

# Plex Home staging (remote cache box; see README "Plex Home staging")
STAGING_ENABLED=false
# Server identities as they appear in webhook payloads, lowercase, comma-separated.
# PH_SERVER_NAMES marks the Philippines cache box (Tautulli {server_name}/{machine_id}, Plex
# webhook Server.title/uuid). CA_EDGE_SERVER_NAMES marks California's constrained cache/fallback
# Plex. PRIMARY_SERVER_NAMES contains only the full Main storage servers. California viewers are
# still in the Main viewing group; this is storage/event routing, not user assignment.
# IMPORTANT: once either edge list is set, webhook events with no server identity are skipped.
# No identity value may appear in more than one list.
# Do not leave old example names such as `*-name-or-machine-id` or `main-server-1` here. The bot
# ignores those placeholders and warns at startup because obeying one would silently enable strict
# webhook routing and discard every event whose server identity does not match it.
PH_SERVER_NAMES=
CA_EDGE_SERVER_NAMES=
PRIMARY_SERVER_NAMES=
# rclone destination for the cache, e.g. phbox:/cache (remote "phbox" from rclone.conf).
# Replace old `phbox:/path-on-*` examples before enabling staging; placeholders produce a startup
# warning and cannot identify a real destination.
STAGE_RCLONE_REMOTE=
# Extra rclone flags, e.g. --config /app/data/rclone.conf --bwlimit 8M
STAGE_RCLONE_FLAGS=
STAGE_RCLONE_BINARY=rclone
# Cache budget in GB for when `rclone about` can't report free space (0 = rclone about only).
STAGE_CACHE_MAX_GB=0
# Headroom the disk-pressure guard keeps free on the cache drive.
STAGE_MIN_FREE_GB=25
STAGE_JOB_TIMEOUT_MINUTES=240
STAGE_CHECK_MINUTES=2
STAGE_MAX_PER_USER_PER_DAY=6
# Cache-tree layout: a staged copy's path RELATIVE to the cache root must match the master library
# tree exactly for a mergerfs local-first view to substitute it (else it's an unused duplicate). The
# master uses `Movies/<folder>` and `TV Shows/<folder>`; override only if yours differs.
STAGE_MOVIES_SUBDIR=Movies
STAGE_TV_SUBDIR=TV Shows
# How often (minutes) to reconcile the staged_items DB against what's actually on the cache drive —
# drops rows whose file vanished (restart / manual wipe / interrupted copy) and re-queues them.
# 0 disables the periodic sweep (the startup sweep still runs once).
STAGE_RECONCILE_MINUTES=30
# Play-triggered promotion (PH pilot; see docs/edge-playback-architecture.md §2.2). When a PH
# viewer starts a title that isn't cached yet, stage it so the NEXT play is local. Requires a
# Tautulli "Playback Start" webhook (event 'play') and/or Plex media.play/resume, carrying the
# PH server identity. Off by default. AUDIT_ONLY logs "would stage" without copying — use it to
# watch the decisions for a while before letting it copy. The cap here is separate from the
# /stage command's cap and is attributed to the linked watcher; the cooldown stops a nightly
# binge from re-copying the same title.
EDGE_PROMOTE_ON_PLAY=false
EDGE_PROMOTE_AUDIT_ONLY=false
EDGE_PROMOTE_COOLDOWN_HOURS=12
EDGE_PROMOTE_MAX_PER_USER_PER_DAY=6
# Tunnel watchdog: URL that only answers when the VPS tunnel to the PH box is alive,
# e.g. https://ph.example.com/identity. Any HTTP response = up; blank disables the check.
# Example URLs such as `https://your-ph-tunnel/identity` are ignored and warned about so they do
# not start a watchdog that can only generate false outage alerts.
PH_TUNNEL_HEALTH_URL=
PH_TUNNEL_CHECK_MINUTES=5
PH_TUNNEL_FAILS_BEFORE_ALERT=3

# Optional Tailscale reachability for PH viewers. The Cloudflare tunnel above is for the bot's
# own HTTP routes only (dashboard/webhooks/downloads) — never media, per Plex's ToS — so a PH
# box behind CGNAT with no IPv6 otherwise has no way for remote viewers to actually watch.
# TAILSCALE_ENABLED=true adds an extra "Approve + Tailscale (PH)" button next to Approve/Deny
# on new access requests, so you can opt a specific person in by hand instead of routing
# everyone through it. Nothing here invites anyone to the tailnet automatically — you still do
# that manually; the bot only assigns them to the PH server and DMs setup instructions.
TAILSCALE_ENABLED=false
TAILSCALE_SETUP_URL=https://tailscale.com/download
TAILSCALE_SERVER_ADDRESS=

# Optional path remapping
PATH_REMAP_FROM=
PATH_REMAP_TO=/mnt/raid

# Storage reporting (/status Storage section + disk-space alerts)
# DISK_SPACE_WARN_GB: warn when a reported volume drops below this many GB (default 100, 0 disables)
DISK_SPACE_WARN_GB=100
# Warn when the recent fill trend projects a full disk within this many days. 0 disables.
DISK_FORECAST_WARN_DAYS=14
# DISK_SPACE_PATHS: comma-separated allowlist of mounts/folders to report. Unset = every *arr mount.
# Set to your real media folder to hide the container's own /, /config disks. A more specific path
# than the reported mount is used as the label, e.g. shows /share/media for the /share mount.
DISK_SPACE_PATHS=

# Optional behavior/security
# Log verbosity: debug, info (default), warn, or error. Anything below the configured level
# is dropped (e.g. LOG_LEVEL=warn silences info/ok/debug lines, keeping only warn and error).
LOG_LEVEL=info
# text (default, human-readable) or json (one JSON object per line: ts/level/msg) for shipping
# to something like Loki/ELK/CloudWatch.
LOG_FORMAT=text
PORT=3000
# On SIGTERM/SIGINT, how long to let in-flight HTTP requests (e.g. a /download/:token stream)
# finish before forcing exit. Keep this under Docker's stop_grace_period (default 10s) or raise
# that in compose if large downloads need longer to drain.
SHUTDOWN_DRAIN_SECONDS=8
# Set true only when exactly one trusted reverse proxy (Cloudflare tunnel/nginx) sits in front.
# Rate limits then use that proxy's client IP header without trusting arbitrary spoofed hops.
TRUST_PROXY=false
ENABLE_DELETION=false
# When deletion is enabled, dry-run logs what would be deleted (file paths + API call)
# without calling any delete API. Set to false only after reviewing a week of real prompts.
DELETION_DRY_RUN=true
DELETION_GRACE_HOURS=24
DELETION_REMINDER_COOLDOWN_HOURS=12
KEEP_LIST_DEFAULT_DAYS=90
LOG_RETENTION_DAYS=90
# How long a "reply with your Plex email" onboarding flag stays valid after the welcome DM.
# Past this, an unsolicited DM from that user is no longer treated as an onboarding reply.
PENDING_EMAIL_EXPIRY_DAYS=14
# Redelivered/replayed webhook payloads within this window are treated as duplicates and dropped
# after the initial processing, so requesters aren't DM'd twice for the same event.
WEBHOOK_DEDUPE_WINDOW_MINUTES=5
WEBHOOK_EVENT_RETENTION_DAYS=3
# In-process, WAL-safe SQLite backups (better-sqlite3 db.backup()). 0 = disabled — the DB holds
# the Discord<->Plex<->Seerr user linkage, the one piece of state here that can't be
# reconstructed from the media servers, so this is worth turning on even alongside a host cron.
BACKUP_INTERVAL_HOURS=0
BACKUP_DIR=/app/data/backups
BACKUP_KEEP_COUNT=14
# How long a request-subscriber row (someone who asked for a title already in flight) survives
# if it's never resolved by the title becoming available or declined.
REQUEST_SUBSCRIBER_RETENTION_DAYS=180
NEVER_DELETE_MEDIA_IDS=
# When false (default), leaving Discord only notifies the admin channel with a
# one-click "Revoke Plex" button instead of silently revoking Plex access.
AUTO_REMOVE_PLEX_ON_LEAVE=false
# Optional: a Discord role ID the bot keeps in sync with actual Plex access — granted on
# approval, revoked on unlink/leave, reconciled by `/sync apply`. Unset (default) = no-op; lets
# you gate channels (e.g. #requests, #whats-new) to real members instead of by convention. The
# bot's own role must sit above this role in the server's role list, and it needs Manage Roles.
PLEX_MEMBER_ROLE_ID=
# Optional community "what's new" posts: every MEDIA_AVAILABLE webhook already flows through the
# bot; when enabled, it also posts a public embed to WHATS_NEW_CHANNEL_ID (falls back to the
# admin channel if unset, like other channel kinds — so only turn this on once a channel is
# ready for it). Multiple seasons of the same show landing within the group window collapse into
# one post instead of one per season.
WHATS_NEW_ENABLED=false
WHATS_NEW_CHANNEL_ID=
WHATS_NEW_GROUP_WINDOW_HOURS=20
# 0 = disabled (default) — every non-admin /request goes through admin approval. Once set, a
# member with this many previously *admin-approved* requests skips the gate (SD/HD only — 4K
# always stays gated). Auto-approvals are still announced in the requests channel with a
# one-click Undo; a denial resets the member's count back to 0.
AUTO_APPROVE_AFTER_N_APPROVED=0
# Posts a server-wide stats recap (titles added, top requesters, most-watched) to the whats_new
# channel roughly every 30 days. /stats is always available on-demand regardless of this setting
# (personal for everyone, server-wide for admins); this only controls the scheduled community post.
MONTHLY_RECAP_ENABLED=false

DOWNLOAD_TOKEN_TTL_HOURS=24
DOWNLOAD_ONE_TIME_LINKS_DEFAULT=false
DOWNLOAD_MAX_PER_HOUR=10
DOWNLOAD_ROUTE_MAX_PER_MINUTE=60
DOWNLOAD_LARGE_FILE_GB=8

# Dashboard auth (set at least one if dashboard enabled).
# Humans can enrol passkeys after signing in with DASHBOARD_ADMIN_PASSWORD (or
# DASHBOARD_ADMIN_TOKEN). Passkeys are bound strictly to https://TUNNEL_DOMAIN; enrol them through
# that public URL, not localhost. The password/token remains the rate-limited fallback.
# Scripts/automation can still authenticate with the x-admin-password / x-admin-token headers.
DASHBOARD_ENABLED=true
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_TOKEN=
STRICT_DASHBOARD_POST_AUTH=true
# Secret used to sign dashboard session cookies. Required whenever DASHBOARD_ENABLED=true — the
# app refuses to start without it. Generate one with `openssl rand -hex 32`. Changing this value
# rotates/invalidates every existing session (users just log in again).
SESSION_SECRET=
# How long a dashboard login stays valid, in hours.
SESSION_TTL_HOURS=12

# Optional compose-only Cloudflare sidecar variable
CLOUDFLARE_TUNNEL_TOKEN=
