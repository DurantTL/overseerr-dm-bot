# ~/.config/restart-logger/env on durant-server: owner media, mode 600 (the script refuses a
# looser file). Optional: with no file, the logger only logs. Never commit the real file.

# Future heartbeat to the bot's Automation → Fleet and host section. OFF unless BOTH are set.
# Leave unset until Caleb approves the wiring. Never the uptime ingest; the script refuses it.
#BOT_HEARTBEAT_URL=https://media.durantlogic.com/api/automation/heartbeat
#BOT_HEARTBEAT_TOKEN=

# Optional, with defaults.
#RESTART_LOGGER_DIR=/home/media/restart-logger
#RESTART_LOGGER_KEEP_DAYS=30
