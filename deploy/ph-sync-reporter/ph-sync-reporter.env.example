# /etc/ph-sync-reporter.env on PH: owner root, mode 600 (the script refuses anything looser).
# Never commit the real file. Never paste the key into chat, a PR or a ticket.

# Required. The Syncthing REST API key from PH's Syncthing config.xml (see README, step 3).
SYNCTHING_API_KEY=

# Required. The four PH folders as id:host-path, separated by ";" (the same format as
# TIER_FOLDERS in /etc/tier-agent.env, which can be copied as-is; JSON is accepted too).
# Verify the ids on the box; the dry run fails if one isn't in Syncthing's config.
PH_SYNC_FOLDERS=

# Optional, with defaults.
#SYNCTHING_URL=http://127.0.0.1:8384
#PH_SYNC_MEDIA_PATH=/mnt/media
#PH_SYNC_LOG_DIR=/var/log/ph-sync-reporter
#PH_SYNC_STATE_DIR=/var/lib/ph-sync-reporter
#PH_SYNC_KEEP_DAYS=60
#PH_SYNC_STALL_WINDOW_MINUTES=120
#PH_SYNC_STALL_MIN_MB=100

# Future heartbeat to the bot: OFF unless both are set. Leave unset until the bot's sync
# heartbeat endpoint exists (a later slice). Never the uptime ingest; the script refuses it.
#BOT_HEARTBEAT_URL=
#BOT_HEARTBEAT_TOKEN=
